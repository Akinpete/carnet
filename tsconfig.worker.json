{
  // The Worker runtime, its tests, and the Cloudflare config.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": ["es2024"],
    "types": ["node", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "src/worker",
    "src/server",
    "src/db",
    "src/shared",
    "test",
    "cloudflare.config.ts",
    ".cloudflare/types"
  ]
}
